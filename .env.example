# Copy to .env.local and fill in. Never commit real values.

# The store's permanent domain, without https://
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Storefront API: products, collections, pages, policies, cart.
# From Sales channels > Headless > the storefront > Storefront API.
# Scopes: unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts,
# unauthenticated_read_content
#
# The private token is the one the server uses. The public token is only a
# fallback for a setup that has no private one.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Customer Account API: sign-in on Shopify's hosted login page.
# From Sales channels > Headless > the storefront > Customer Account API.
# A confidential client has both values; a public client has only the ID.
# The storefront's callback URL list must include <site>/account/callback, and
# its logout URL list must include <site>. Shopify accepts https addresses
# only, so sign-in can't be tested on plain http://localhost: use the deployed
# site, or a tunnel with SITE_URL set to the tunnel's address.
SHOPIFY_CUSTOMER_CLIENT_ID=
SHOPIFY_CUSTOMER_CLIENT_SECRET=

# Admin API: writes the quiz archetype to the customer. Needs write_customers.
# Use ONE of the two options below.

# Option A: an existing admin-created custom app (static token, starts with shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option B: a Dev Dashboard app in the same organisation as the store
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The site's public address, without a trailing slash. Used for the sitemap,
# share images and the sign-in callback. Before launch, set it to the
# deployment's https://<project>.vercel.app address so sign-in has a fixed
# callback. Search engines are told to stay away until this is a real domain,
# so at launch set it to that domain and redeploy.
SITE_URL=

# Shown on the Contact page. Leave empty to hide that page and its footer link.
CONTACT_EMAIL=

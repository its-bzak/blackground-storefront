# Copy to .env.local and fill in. Never commit real values.

# The store's permanent domain, without https://
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Storefront API: products, collections, cart, customer login.
# Scopes: unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts,
# unauthenticated_write_customers, unauthenticated_read_customers, unauthenticated_read_content
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API: writes the quiz archetype to the customer. Needs write_customers.
# Use ONE of the two options below.

# Option A: an existing admin-created custom app (static token, starts with shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option B: a Dev Dashboard app in the same organisation as the store
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

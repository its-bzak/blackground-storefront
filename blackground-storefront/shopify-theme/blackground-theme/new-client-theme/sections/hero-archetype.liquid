<section class="hero-archetype full-width">
  <div class="hero-archetype__stack">
    <div class="hero-archetype__card hero-archetype__card--back">
      {% if section.settings.card_back_image != blank %}
        <img
          src="{{ section.settings.card_back_image | image_url: width: 1600 }}"
          alt=""
          loading="lazy"
          width="{{ section.settings.card_back_image.width }}"
          height="{{ section.settings.card_back_image.height }}"
        >
      {% endif %}
    </div>

    <div class="hero-archetype__card hero-archetype__card--mid">
      {% if section.settings.card_mid_image != blank %}
        <img
          src="{{ section.settings.card_mid_image | image_url: width: 1600 }}"
          alt=""
          loading="lazy"
          width="{{ section.settings.card_mid_image.width }}"
          height="{{ section.settings.card_mid_image.height }}"
        >
      {% endif %}
    </div>

    <div class="hero-archetype__card hero-archetype__card--front">
      {% if section.settings.card_front_image != blank %}
        <img
          src="{{ section.settings.card_front_image | image_url: width: 1800 }}"
          alt=""
          loading="eager"
          width="{{ section.settings.card_front_image.width }}"
          height="{{ section.settings.card_front_image.height }}"
        >
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a
          class="hero-archetype__cta bg-mono"
          href="{{ section.settings.cta_link | default: '#' }}"
        >
          {{ section.settings.cta_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <a
    class="hero-archetype__corner hero-archetype__corner--left bg-link"
    href="{{ section.settings.about_link | default: '/pages/about' }}"
  >
    ABOUT
  </a>

  <a
    class="hero-archetype__corner hero-archetype__corner--right bg-link"
    href="{{ section.settings.products_link | default: routes.all_products_collection_url }}"
  >
    PRODUCTS
  </a>
</section>

{% stylesheet %}
  html:has(body.template-index) {
    overflow: hidden;
  }

  body.template-index {
    overflow: hidden;
  }

  .hero-archetype {
    --hero-block-size: calc(100svh - var(--header-height));
    --hero-padding-top: clamp(2rem, 5vh, 4rem);
    --hero-padding-bottom: 0rem;
    --hero-inline-padding: clamp(1rem, 4vw, 3rem);
    --hero-available-height: calc(var(--hero-block-size) - var(--hero-padding-top) - var(--hero-padding-bottom));
    position: relative;
    width: 100%;
    block-size: var(--hero-block-size);
    min-block-size: var(--hero-block-size);
    padding-block: var(--hero-padding-top) var(--hero-padding-bottom);
    padding-inline: var(--hero-inline-padding);
    display: grid;
    justify-items: center;
    align-items: end;
    overflow: hidden;
  }

  .hero-archetype__stack {
    position: relative;
    width: min(82%, 78rem, calc(var(--hero-available-height) * 16 / 11));
    aspect-ratio: 16 / 11;
  }

  .hero-archetype__card {
    position: absolute;
    border-radius: 100px 100px 0 0;
    background: var(--media-gray);
    overflow: hidden;
  }

  .hero-archetype__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-archetype__card--back {
    inset-block-start: 0;
    inset-inline: 8%;
    inset-block-end: 8%;
    background: var(--media-gray-dark);
    z-index: 1;
  }

  .hero-archetype__card--mid {
    inset-block-start: 3.5%;
    inset-inline: 4%;
    inset-block-end: 4%;
    background: #7f7f7d;
    z-index: 2;
  }

  .hero-archetype__card--front {
    inset-block-start: 8%;
    inset-inline: 0;
    inset-block-end: 0;
    background: var(--media-gray);
    z-index: 3;
  }

  .hero-archetype__cta {
    position: absolute;
    inset-block-end: clamp(1.5rem, 5%, 3rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16rem;
    padding: 0.9rem 1.6rem;
    border: 1px solid var(--gold);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
    z-index: 4;
  }

  .hero-archetype__cta:hover,
  .hero-archetype__cta:focus-visible {
    background: var(--gold);
    color: var(--bg);
  }

  .hero-archetype__corner {
    position: absolute;
    inset-block-end: clamp(1rem, 3vh, 2rem);
    color: var(--gold);
  }

  .hero-archetype__corner--left {
    inset-inline-start: clamp(1rem, 3vw, 2.5rem);
  }

  .hero-archetype__corner--right {
    inset-inline-end: clamp(1rem, 3vw, 2.5rem);
  }

  @media screen and (max-width: 749px) {
    .hero-archetype {
      --hero-padding-bottom: 0rem;
    }

    .hero-archetype__stack {
      width: min(88%, calc(var(--hero-available-height) * 4 / 5));
      aspect-ratio: 4 / 5;
    }

    .hero-archetype__cta {
      min-width: 14rem;
      font-size: 0.8125rem;
      padding: 0.8rem 1.2rem;
    }

    .hero-archetype__corner {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Archetype hero",
  "settings": [
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "FIND YOUR ARCHETYPE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Bottom links"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About link"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Products link"
    },
    {
      "type": "header",
      "content": "Card images (optional)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use solid gray placeholders."
    },
    {
      "type": "image_picker",
      "id": "card_front_image",
      "label": "Front card image"
    },
    {
      "type": "image_picker",
      "id": "card_mid_image",
      "label": "Middle card image"
    },
    {
      "type": "image_picker",
      "id": "card_back_image",
      "label": "Back card image"
    }
  ],
  "presets": [
    {
      "name": "Archetype hero"
    }
  ]
}
{% endschema %}

{{ 'archetype-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'archetype-hero.js' | asset_url }}" defer></script>

<section class="archetype-hero">
  <div class="stage" id="archetype-stage">
    {% for block in section.blocks %}
      <article
        class="card {{ block.settings.card_class }}"
        data-i="{{ forloop.index0 }}"
        data-screen-label="{{ block.settings.screen_label }}"
        {{ block.shopify_attributes }}
      >
        <div class="card-bg"></div>
        <div class="card-over"></div>

        <div class="ghost">{{ block.settings.ghost_text }}</div>

        <div class="card-body">
          <div class="card-num">
            {{ forloop.index | prepend: '0' }} / {{ section.blocks.size | prepend: '0' }}
          </div>

          <div class="card-label">
            {{ block.settings.label }}
          </div>

          <h2 class="card-hl">
            {{ block.settings.headline_1 }}<br>
            {{ block.settings.headline_2 }}
          </h2>

          <p class="card-sub">
            {{ block.settings.card_subtext }}
          </p>
        </div>

        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a class="find-btn" href="{{ block.settings.button_link }}">
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      </article>
    {% endfor %}
  </div>

  <div class="dots" id="archetype-dots"></div>
</section>


<a href="{{ routes.all_products_collection_url }}">Back to Shop</a>
<h1>Cart</h1>

{% form 'cart', cart %}
  {% for item in cart.items %}
    <div>
      {% if item.image %}
        <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.image.alt | escape }}" width="100" height="{{ item.image.height }}" style="max-width: 100px; height: auto; object-fit: contain;">
      {% endif %}
      <a href="{{ item.url }}">{{ item.product.title }}</a>
      <span>{{ item.variant.title }}</span>
      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
    </div>
  {% endfor %}

  <p>{{ cart.total_price | money }}</p>
  <button type="submit" name="update">Update cart</button>
  <button type="submit" name="checkout">Checkout</button>
{% endform %}

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
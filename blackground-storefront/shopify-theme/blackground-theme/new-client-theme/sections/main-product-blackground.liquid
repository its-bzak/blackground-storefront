{{ 'blackground-product.css' | asset_url | stylesheet_tag }}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign gallery_count = media_count | at_most: 8
  if gallery_count == 0
    assign gallery_count = 1
  endif
  assign archetype = product.metafields.custom.archetype.value | default: product.metafields.custom.archetype
  assign care_instructions = product.metafields.custom.care_instructions
  assign fit_details = product.metafields.custom.fit
%}

<section
  class="bg-pdp"
  data-bg-product-root
  data-section-id="{{ section.id }}"
>
  <script type="application/json" data-bg-product-json>
    {{ product | json }}
  </script>

  <div class="bg-pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="bg-pdp__sep">/</span>
    {% if collection %}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="bg-pdp__sep">/</span>
    {% endif %}
    <span class="bg-pdp__current">{{ product.title }}</span>
  </div>

  <div class="bg-pdp__layout">
    <div class="bg-pdp__gallery" data-bg-gallery>
      <div class="bg-pdp__gallery-stack" data-bg-gallery-stack>
        {% if media_count > 0 %}
          {% for media in product.media limit: 8 %}
            <div
              class="bg-pdp__g-card{% if forloop.first %} is-active{% endif %}"
              data-bg-gallery-card
              data-media-position="{{ forloop.index0 }}"
              style="--card-index: {{ forloop.index0 }};"
            >
              <div class="bg-pdp__g-card-bg"></div>
              <div class="bg-pdp__g-card-overlay"></div>

              {% case media.media_type %}
                {% when 'image' %}
                  <img
                    class="bg-pdp__g-card-photo"
                    src="{{ media | image_url: width: 1500 }}"
                    srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1500 }} 1500w"
                    sizes="(max-width: 900px) 92vw, 42vw"
                    alt="{{ media.alt | default: product.title | escape }}"
                    width="{{ media.preview_image.width }}"
                    height="{{ media.preview_image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                {% when 'video', 'external_video' %}
                  {{ media | media_tag: class: 'bg-pdp__media-video', image_size: '1200x' }}
                {% when 'model' %}
                  {{ media | media_tag: class: 'bg-pdp__media-model', image_size: '1200x' }}
              {% endcase %}

              {% if archetype != blank %}
                <div class="bg-pdp__g-card-tag">{{ archetype }}</div>
              {% endif %}
              <div class="bg-pdp__g-card-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ gallery_count | prepend: '0' | slice: -2, 2 }}</div>
              <div class="bg-pdp__g-card-label">{{ media.alt | default: 'View' }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="bg-pdp__g-card is-active" data-bg-gallery-card>
            <div class="bg-pdp__g-card-bg"></div>
            <div class="bg-pdp__g-card-overlay"></div>
            <div class="bg-pdp__placeholder" aria-hidden="true">{{ product.title }}</div>
          </div>
        {% endif %}
      </div>

      <div class="bg-pdp__gallery-controls">
        <div class="bg-pdp__g-dots" data-bg-gallery-dots></div>
        <div class="bg-pdp__g-counter" data-bg-gallery-counter>01 / {{ gallery_count | prepend: '0' | slice: -2, 2 }}</div>
        <div class="bg-pdp__g-nav">
          <button class="bg-pdp__g-nav-btn" type="button" data-bg-gallery-prev aria-label="Previous image">
            <svg fill="none" height="11" stroke="currentColor" stroke-width="1.5" viewBox="0 0 11 11" width="11"><path d="M5.5 9L1.5 5.5l4-3.5M9.5 5.5H1.5"></path></svg>
          </button>
          <button class="bg-pdp__g-nav-btn" type="button" data-bg-gallery-next aria-label="Next image">
            <svg fill="none" height="11" stroke="currentColor" stroke-width="1.5" viewBox="0 0 11 11" width="11"><path d="M5.5 2l4 3.5-4 3.5M1.5 5.5h8"></path></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="bg-pdp__info">
      {% form 'product', product, class: 'bg-pdp__form', data-bg-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-bg-variant-id>

        {% if archetype != blank %}
          <div class="bg-pdp__arch-label">{{ archetype }}</div>
        {% endif %}

        <h1 class="bg-pdp__title">{{ product.title }}</h1>
        <div class="bg-pdp__edition">{{ product.vendor }}</div>
        <div class="bg-pdp__price" data-bg-price>{{ current_variant.price | money }}</div>

        {% if product.description != blank %}
          <div class="bg-pdp__quote">
            <p>{{ product.description | strip_html | truncatewords: 24 }}</p>
          </div>
        {% endif %}

        <div class="bg-pdp__options">
          {% for option in product.options_with_values %}
            {% liquid
              assign option_name_downcase = option.name | downcase
              assign is_color = false
              if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
                assign is_color = true
              endif
            %}

            <fieldset class="bg-pdp__option-group" data-bg-option-group data-option-position="{{ option.position }}">
              <legend class="bg-pdp__option-label">
                <span>{{ option.name }}</span>
                {% if is_color %}<span class="bg-pdp__option-value" data-bg-color-label>{{ option.selected_value }}</span>{% endif %}
              </legend>

              <div class="{% if is_color %}bg-pdp__color-options{% else %}bg-pdp__size-options{% endif %}" role="list">
                {% for value in option.values %}
                  {% liquid
                    assign safe_value = value | escape
                    assign is_selected = false
                    if option.selected_value == value
                      assign is_selected = true
                    endif
                  %}
                  <button
                    type="button"
                    class="{% if is_color %}bg-pdp__color-opt{% else %}bg-pdp__size-opt{% endif %}{% if is_selected %} is-selected{% endif %}"
                    data-bg-option-button
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ safe_value }}"
                    {% if is_color %}title="{{ safe_value }}" aria-label="{{ safe_value }}"{% endif %}
                  >
                    {% if is_color %}
                      {% liquid
                        assign swatch_color = value | downcase | strip
                        case swatch_color
                          when 'black', 'onyx'
                            assign swatch_color = '#080808'
                          when 'white', 'ivory', 'cream', 'natural'
                            assign swatch_color = '#f2f0eb'
                          when 'gold'
                            assign swatch_color = '#d4af00'
                          when 'grey', 'gray', 'stone', 'smoke', 'smokewash'
                            assign swatch_color = '#7d7a72'
                          when 'navy', 'midnight'
                            assign swatch_color = '#101826'
                          when 'brown'
                            assign swatch_color = '#6a4938'
                          when 'green'
                            assign swatch_color = '#2f4a35'
                          when 'red', 'rose'
                            assign swatch_color = '#8a3838'
                        endcase
                      %}
                      <span class="bg-pdp__color-dot" style="--swatch: {{ swatch_color }};"></span>
                    {% else %}
                      {{ value }}
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>

        <div class="bg-pdp__actions">
          <button class="bg-pdp__add-btn" type="submit" data-bg-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}Add to Bag{% else %}Sold Out{% endif %}
          </button>
          <button class="bg-pdp__wish-btn" type="button" data-bg-wishlist aria-label="Wishlist">
            <svg fill="none" height="18" stroke="currentColor" stroke-width="1.5" viewBox="0 0 18 18" width="18"><path d="M9 16C9 16 1.5 11 1.5 6.25C1.5 3.6 3.5 1.5 6 1.5C7.5 1.5 8.5 2.5 9 3.5C9.5 2.5 10.5 1.5 12 1.5C14.5 1.5 16.5 3.6 16.5 6.25C16.5 11 9 16 9 16Z"></path></svg>
          </button>
        </div>

        <div class="bg-pdp__details">
          {% if product.description != blank %}
            <div class="bg-pdp__detail-row is-open">
              <button class="bg-pdp__detail-header" type="button" data-bg-accordion>Description <span class="bg-pdp__plus">+</span></button>
              <div class="bg-pdp__detail-body rte">{{ product.description }}</div>
            </div>
          {% endif %}

          {% if fit_details != blank %}
            <div class="bg-pdp__detail-row">
              <button class="bg-pdp__detail-header" type="button" data-bg-accordion>Fit &amp; Silhouette <span class="bg-pdp__plus">+</span></button>
              <div class="bg-pdp__detail-body rte">{{ fit_details | metafield_tag }}</div>
            </div>
          {% endif %}

          {% if care_instructions != blank %}
            <div class="bg-pdp__detail-row">
              <button class="bg-pdp__detail-header" type="button" data-bg-accordion>Materials &amp; Care <span class="bg-pdp__plus">+</span></button>
              <div class="bg-pdp__detail-body rte">{{ care_instructions | metafield_tag }}</div>
            </div>
          {% endif %}

          <div class="bg-pdp__detail-row">
            <button class="bg-pdp__detail-header" type="button" data-bg-accordion>Shipping &amp; Returns <span class="bg-pdp__plus">+</span></button>
            <div class="bg-pdp__detail-body rte">
              <p>{{ section.settings.shipping_text }}</p>
            </div>
          </div>
        </div>

        <div class="bg-pdp__trust">
          <span>↻ Free returns</span>
          <span>✶ Made in NYC</span>
          <span>◆ Organic cotton</span>
        </div>
      {% endform %}
    </div>

    <aside class="bg-pdp__related" aria-label="Related products">
      <h3 class="bg-pdp__related-title">{{ section.settings.related_heading }}</h3>
      <div class="bg-pdp__related-grid">
        {% liquid
          assign related_products = product.collections.first.products
          assign rendered_related = 0
        %}
        {% for related_product in related_products limit: 8 %}
          {% unless related_product.id == product.id or rendered_related >= 4 %}
            {% assign rendered_related = rendered_related | plus: 1 %}
            <a class="bg-pdp__r-card" href="{{ related_product.url }}">
              <div class="bg-pdp__r-img">
                {% if related_product.featured_image %}
                  <img src="{{ related_product.featured_image | image_url: width: 500 }}" alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}" loading="lazy">
                {% endif %}
              </div>
              <div class="bg-pdp__r-arch">{{ related_product.vendor }}</div>
              <div class="bg-pdp__r-name">{{ related_product.title }}</div>
              <div class="bg-pdp__r-price">{{ related_product.price | money }}</div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    </aside>
  </div>

  <div class="bg-pdp__toast" data-bg-toast>Added to bag</div>
</section>

<script src="{{ 'blackground-product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Blackground product page",
  "settings": [
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related heading",
      "default": "Other Archetypes"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "Free shipping on orders over $100. 30-day returns on unworn merchandise. We ship worldwide within 1–3 business days."
    }
  ],
  "presets": [
    {
      "name": "Blackground product page"
    }
  ]
}
{% endschema %}

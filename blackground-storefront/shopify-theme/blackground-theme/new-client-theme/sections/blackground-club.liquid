    color: var(--white);
    font-family: 'Space Grotesk', sans-serif;
    text-wrap: pretty;
  }

  .blackground-club-page .gold {
    color: var(--gold);
  }

  .club-top-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
    z-index: 300;
    background: rgba(8, 8, 8, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(212, 175, 0, 0.08);
  }

  .club-nav-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--gold);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  .club-nav-logo img {
    width: 130px;
    height: auto;
    display: block;
    filter: drop-shadow(0 0 12px rgba(212, 175, 0, 0.25));
  }

  .club-nav-link {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .club-nav-link:hover {
    opacity: 1;
  }

  .club-main {
    padding-top: var(--nav-h);
  }

  .club-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: clamp(60px, 8vw, 120px) clamp(28px, 6vw, 96px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .club-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 70% 50%, rgba(212, 175, 0, 0.06) 0%, transparent 70%),
      repeating-linear-gradient(0deg, transparent, transparent 80px, rgba(212, 175, 0, 0.025) 80px, rgba(212, 175, 0, 0.025) 81px);

    pointer-events: none;
  }

  .club-card-label .top,
  .club-card-label .row {
    display: flex;
    justify-content: space-between;
  }

  .club-card-label .wordmark,
  .club-card-label .row {
    font-size: clamp(9px, 1vw, 11px);
    font-weight: 700;
    letter-spacing: 0.22em;

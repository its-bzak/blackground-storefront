{% if template.name == 'index' %}
  <nav style="position: fixed; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; padding: 32px; z-index: 300; pointer-events: none;">
    <div style="pointer-events: auto;">
      <a href="{{ routes.all_products_collection_url }}" style="color: #D4AF00; text-transform: uppercase;">SHOP</a>
    </div>
    <div style="pointer-events: auto;">
      {% if customer %}
        <span style="color: #D4AF00; text-transform: uppercase;">{{ customer.email }}</span>
        <a href="{{ routes.account_logout_url }}" style="color: #D4AF00; text-transform: uppercase;">LOGOUT</a>
      {% else %}
        <a href="{{ routes.account_login_url }}" style="color: #D4AF00; text-transform: uppercase;">LOGIN</a>
      {% endif %}
    </div>
  </nav>
{% else %}
  <header style="position: absolute; top: 0; left: 0; padding: 32px;">
    <a href="javascript:history.back()" style="color: #D4AF00; text-decoration: none; text-transform: uppercase; font-weight: bold;">&larr; BACK</a>
  </header>
{% endif %}

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
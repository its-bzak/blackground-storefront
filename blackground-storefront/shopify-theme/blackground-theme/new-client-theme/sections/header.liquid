<header class="bg-header full-width" role="banner">
  <div class="bg-header__inner">
    <a
      class="bg-header__link bg-header__link--left bg-link"
      href="{{ section.settings.left_link | default: routes.root_url }}"
    >
      {{ section.settings.left_label | default: 'MENU' }}
    </a>

    <a
      class="bg-header__wordmark bg-serif"
      href="{{ section.settings.wordmark_link | default: routes.root_url }}"
      aria-label="{{ shop.name }}"
    >
      {{ section.settings.wordmark | default: 'BLACKGROUND' }}
    </a>

    <a
      class="bg-header__link bg-header__link--right bg-link"
      href="{{ section.settings.right_link | default: routes.account_register_url }}"
    >
      {{ section.settings.right_label | default: 'JOIN US' }}
    </a>
  </div>
</header>

{% stylesheet %}
  .bg-header {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: var(--header-bg);
    color: var(--gold);
  }

  .bg-header__inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-md);
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  .bg-header__link {
    color: var(--gold);
  }

  .bg-header__link--left {
    justify-self: start;
  }

  .bg-header__link--right {
    justify-self: end;
  }

  .bg-header__wordmark {
    justify-self: center;
    color: var(--gold);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.875rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  @media screen and (max-width: 480px) {
    .bg-header__link {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "default": "BLACKGROUND"
    },
    {
      "type": "url",
      "id": "wordmark_link",
      "label": "Wordmark link"
    },
    {
      "type": "header",
      "content": "Left link"
    },
    {
      "type": "text",
      "id": "left_label",
      "label": "Label",
      "default": "MENU"
    },
    {
      "type": "url",
      "id": "left_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Right link"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "Label",
      "default": "JOIN US"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Link"
    }
  ]
}
{% endschema %}

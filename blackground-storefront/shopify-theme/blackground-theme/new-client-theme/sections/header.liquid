{% liquid
  assign is_product_grid_page = false
  if request.page_type == 'collection' or request.page_type == 'list-collections'
    assign is_product_grid_page = true
  endif
%}

<header class="bg-header full-width" role="banner">
  <div class="bg-header__inner">
    <a
      class="bg-header__link bg-header__link--left bg-link"
      href="{% if is_product_grid_page %}{{ routes.root_url }}{% else %}{{ section.settings.left_link | default: routes.root_url }}{% endif %}"
    >
      {% if is_product_grid_page %}
        BACK
      {% else %}
        {{ section.settings.left_label | default: 'MENU' }}
      {% endif %}
    </a>

    <a
      class="bg-header__wordmark bg-serif"
      href="{{ section.settings.wordmark_link | default: routes.root_url }}"
      aria-label="{{ shop.name }}"
    >
      <img
        class="bg-header__wordmark-image"
        src="{{ 'blackground_logo_text.png' | asset_url }}"
        alt="{{ shop.name }}"
        loading="eager"
      >
    </a>

    {% unless is_product_grid_page %}
      <a
        class="bg-header__link bg-header__link--right bg-link"
        href="{{ section.settings.right_link | default: routes.account_register_url }}"
      >
        {{ section.settings.right_label | default: 'JOIN US' }}
      </a>
    {% endunless %}
  </div>
</header>

{% stylesheet %}
  .bg-header {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 100;
    height: var(--header-height);
    color: var(--gold);
  }

  .bg-header__inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-md);
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  .bg-header__link {
    color: var(--gold);
  }

  .bg-header__link--left {
    justify-self: start;
  }

  .bg-header__link--right {
    justify-self: end;
  }

  .bg-header__wordmark {
    justify-self: center;
    color: var(--gold);
    line-height: 1;
  }

  .bg-header__wordmark-image {
    display: block;
    height: clamp(24px, 2.8vw, 32px);
    width: auto;
    filter: drop-shadow(0 0 12px rgba(212, 175, 0, 0.18));
  }

  @media screen and (max-width: 480px) {
    .bg-header__link {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "default": "BLACKGROUND"
    },
    {
      "type": "url",
      "id": "wordmark_link",
      "label": "Wordmark link"
    },
    {
      "type": "header",
      "content": "Left link"
    },
    {
      "type": "text",
      "id": "left_label",
      "label": "Label",
      "default": "MENU"
    },
    {
      "type": "url",
      "id": "left_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Right link"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "Label",
      "default": "JOIN US"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Link"
    }
  ]
}
{% endschema %}

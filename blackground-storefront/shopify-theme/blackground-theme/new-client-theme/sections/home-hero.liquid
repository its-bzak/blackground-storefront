<section class="hero full-width" data-hero-reveal>
  <div
    class="hero__inner hero__inner--top hero__inner--animated"
    {% if section.settings.top_background != blank %}
      style="background-image: linear-gradient(hsl(0 0% 5% / 0.2), hsl(0 0% 5% / 0.2)), url('{{ section.settings.top_background | image_url: width: 2200 }}');"
    {% endif %}
  >
    <div class="hero__content hero__content--top">
      <div class="hero__model-stage">
        <img
          class="hero__model-image hero__model-image--featured hero__model-image--male"
          src="{{ 'model-images/man_with_dark_blackground_t_shirt.png' | asset_url }}"
          alt="Model wearing a dark Blackground t-shirt"
          loading="eager"
          width="1344"
          height="768"
        >
        <img
          class="hero__model-image hero__model-image--featured hero__model-image--female"
          src="{{ 'model-images/woman_with_light_blackground_t_shirt.png' | asset_url }}"
          alt="Model wearing a light Blackground t-shirt"
          loading="eager"
          width="1344"
          height="768"
        >
      </div>

      <div class="hero__right hero__right--cta">
        <p class="hero__cta-text">
          Your outfit is your voice before you even speak. 
          <br>
          Make sure it says something real. 
          <br>
          Make sure it says you.
        </p>
          <a class="hero__cta-button" href="{{ routes.all_products_collection_url }}">Explore products</a>
      </div>
    </div>
  </div>

  <div
    class="hero__inner hero__inner--preview hero__inner--animated"
    {% if section.settings.middle_background != blank %}
      style="background-image: linear-gradient(hsl(0 0% 5% / 0.2), hsl(0 0% 5% / 0.2)), url('{{ section.settings.middle_background | image_url: width: 2200 }}');"
    {% endif %}
  >
    <div class="hero__content hero__content--preview">
      <div class="hero__preview-item"></div>
      <div class="hero__preview-item"></div>
      <div class="hero__preview-item"></div>
    </div>
  </div>

  <div
    class="hero__inner hero__inner--bottom hero__inner--animated"
    {% if section.settings.bottom_background != blank %}
      style="background-image: linear-gradient(hsl(0 0% 5% / 0.2), hsl(0 0% 5% / 0.2)), url('{{ section.settings.bottom_background | image_url: width: 2200 }}');"
    {% endif %}
  >
    <div class="hero__content hero__content--split">
      <div class="hero__left"></div>

      <div class="hero__right">
        <div class="hero__right-panel hero__right-panel--top"></div>
        <div class="hero__right-panel hero__right-panel--bottom"></div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    --hero-header-offset: 7rem;
    --hero-footer-offset: 6rem;
    background: hsl(0 0% 5%);
    border-top: 0.5px solid hsl(0 0% 24%);
    border-bottom: 0.5px solid hsl(0 0% 24%);
  }

  .hero__inner {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 100svh;
    margin-inline: auto;
    padding-block: 2rem;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .hero__content {
    display: grid;
    align-items: stretch;
    gap: 1rem;
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .hero__content--split {
    grid-template-columns: 2.5fr 1.5fr;
  }

  .hero__content--top {
    grid-template-columns: minmax(0, 1.75fr) minmax(24rem, 1.15fr);
    align-items: end;
    align-self: end;
    column-gap: 0.5rem;
    min-height: calc(100svh - var(--hero-header-offset) - 2rem);
  }

  .hero__inner--top {
    align-items: end;
    padding-block: 2rem 0;
    overflow: hidden;
  }

  .hero__inner:first-child {
    min-height: calc(100svh - var(--hero-header-offset));
    scroll-margin-top: var(--hero-header-offset);
  }

  .hero__inner:last-child {
    min-height: calc(100svh - var(--hero-footer-offset));
  }

  .hero__inner--animated {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
    will-change: opacity, transform;
  }

  .hero__inner--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero__inner--reverse {
    grid-template-columns: 1.5fr 2.5fr;
  }

  .hero__content--preview {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero__left,
  .hero__right,
  .hero__preview-item {
    min-height: 32rem;
    border-radius: 1.5rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    backdrop-filter: blur(10px);
  }

  .hero__left {
    padding: 1.5rem;
    background: hsl(0 0% 18% / 0.42);
  }

  .hero__model-stage {
    position: relative;
    min-height: 100%;
    display: grid;
    align-items: end;
    justify-items: center;
    overflow: hidden;
  }

  .hero__left--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .hero__left-panel {
    overflow: hidden;
    position: relative;
    height: 100%;
    border-radius: 1.25rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
    background: hsl(0 0% 92% / 0.14);
  }

  .hero__panel-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero__model-image {
    display: block;
    width: min(100%, 44rem);
    height: auto;
  }

  .hero__model-image--featured {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: 0;
    width: min(84%, 36rem);
    max-width: none;
    max-height: calc(100svh - var(--hero-header-offset) - 2rem);
    transform: translateX(-50%) scaleX(0.72) scaleY(0.84);
    transform-origin: center bottom;
    filter: drop-shadow(0 2rem 3.5rem hsl(0 0% 0% / 0.45));
  }

  .hero__model-image--male {
    z-index: 1;
    transform: translateX(-64%) scaleX(0.72) scaleY(0.84);
  }

  .hero__model-image--female {
    z-index: 2;
    transform: translateX(-36%) scaleX(0.72) scaleY(0.84);
  }

  .hero__right {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1rem;
    padding: 1.5rem;
    background: hsl(0 0% 14% / 0.5);
  }

  .hero__content--top .hero__right {
    align-self: center;
  }

  .hero__right--cta {
    grid-template-rows: none;
    align-content: center;
    background: transparent;
    backdrop-filter: none;
    border: 0;
      gap: 1.5rem;
  }

  .hero__cta-text {
    margin: 0;
    color: #f3c90b;
    font-size: clamp(1.8rem, 1.15rem + 1.5vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 900;
    text-wrap: balance;
  }

    .hero__cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-height: 3.25rem;
      padding: 0.9rem 1.4rem;
      border: 1px solid #f3c90b;
      border-radius: 999px;
      color: #f3c90b;
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition:
        background-color 180ms ease,
        color 180ms ease,
        border-color 180ms ease;
    }

    .hero__cta-button:hover,
    .hero__cta-button:focus-visible {
      background: #f3c90b;
      color: hsl(0 0% 5%);
      border-color: #f3c90b;
    }

  .hero__right-panel {
    border-radius: 1.25rem;
    border: 1px solid hsl(0 0% 100% / 0.08);
  }

  .hero__right-panel--top {
    background: hsl(0 0% 90% / 0.18);
  }

  .hero__right-panel--bottom {
    background: hsl(0 0% 72% / 0.1);
  }

  .hero__preview-item:nth-child(1) {
    background: hsl(0 0% 92% / 0.14);
  }

  .hero__preview-item:nth-child(2) {
    background: hsl(0 0% 82% / 0.2);
  }

  .hero__preview-item:nth-child(3) {
    background: hsl(0 0% 72% / 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__inner--animated {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 989px) {
    .hero__content--split {
      grid-template-columns: 1fr;
    }

    .hero__content--top {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero__model-stage {
      min-height: clamp(28rem, 60svh, 40rem);
    }

    .hero__model-image--featured {
      width: min(100%, 32rem);
      transform: translateX(-50%) scale(1.04);
    }

    .hero__model-image--male {
      transform: translateX(-62%) scale(1.04);
    }

    .hero__model-image--female {
      transform: translateX(-38%) scale(1.04);
    }
  }

  @media screen and (max-width: 749px) {
    .hero__content--split {
      grid-template-rows: 3fr 1fr;
    }

    .hero__left,
    .hero__right,
    .hero__preview-item {
      min-height: 0;
    }

    .hero__left,
    .hero__right {
      padding: 1rem;
    }

    .hero__content--top {
      gap: 1.25rem;
    }

    .hero__model-stage {
      min-height: 24rem;
    }

    .hero__model-image--featured {
      width: min(100%, 26rem);
      transform: translateX(-50%);
    }

    .hero__model-image--male {
      transform: translateX(-58%);
    }

    .hero__model-image--female {
      transform: translateX(-42%);
    }

    .hero__left--split {
      grid-template-columns: 1fr 1fr;
    }

    .hero__content--preview {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc(100% - 2.5rem);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      align-items: stretch;
    }

    .hero__inner--preview::-webkit-scrollbar {
      display: none;
    }

    .hero__preview-item {
      scroll-snap-align: center;
      scroll-snap-stop: always;
      min-height: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroSections = document.querySelectorAll('[data-hero-reveal]');

  heroSections.forEach((section) => {
    const rows = section.querySelectorAll('.hero__inner--animated');

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      rows.forEach((row) => row.classList.add('hero__inner--visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('hero__inner--visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: '0px 0px -10% 0px',
      }
    );

    rows.forEach((row) => observer.observe(row));
  });
{% endjavascript %}

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_background",
      "label": "Top section background"
    },
    {
      "type": "image_picker",
      "id": "middle_background",
      "label": "Middle section background"
    },
    {
      "type": "image_picker",
      "id": "bottom_background",
      "label": "Bottom section background"
    }
  ],
  "presets": [
    {
      "name": "Home hero"
    }
  ]
}
{% endschema %}
<section class="hero full-width" data-hero-reveal>
  <div class="hero__inner hero__inner--top hero__inner--animated">
    <div class="hero__left hero__left--split">
      <div class="hero__left-panel"></div>
      <div class="hero__left-panel"></div>
    </div>

    <div class="hero__right">
      <div class="hero__right-panel hero__right-panel--top"></div>
      <div class="hero__right-panel hero__right-panel--bottom"></div>
    </div>
  </div>

  <div class="hero__inner hero__inner--preview hero__inner--animated">
    <div class="hero__preview-item"></div>
    <div class="hero__preview-item"></div>
    <div class="hero__preview-item"></div>
  </div>

  <div class="hero__inner hero__inner--bottom hero__inner--animated">
    <div class="hero__left"></div>

    <div class="hero__right">
      <div class="hero__right-panel hero__right-panel--top"></div>
      <div class="hero__right-panel hero__right-panel--bottom"></div>
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    --hero-header-offset: 7rem;
    --hero-footer-offset: 6rem;
    background: hsl(0 0% 5%);
    border-top: 0.5px solid hsl(0 0% 24%);
    border-bottom: 0.5px solid hsl(0 0% 24%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 2.5fr 1.5fr;
    align-items: stretch;
    gap: 1rem;
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    min-height: 100svh;
    margin-inline: auto;
    padding-block: 2rem;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .hero__inner:first-child {
    min-height: calc(100svh - var(--hero-header-offset));
    scroll-margin-top: var(--hero-header-offset);
  }

  .hero__inner:last-child {
    min-height: calc(100svh - var(--hero-footer-offset));
  }

  .hero__inner--animated {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
    will-change: opacity, transform;
  }

  .hero__inner--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero__inner--reverse {
    grid-template-columns: 1.5fr 2.5fr;
  }

  .hero__inner--preview {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero__left,
  .hero__right,
  .hero__preview-item {
    min-height: 32rem;
    border-radius: 1.5rem;
  }

  .hero__left {
    padding: 1.5rem;
    background: hsl(201 100% 50%);
  }

  .hero__left--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .hero__left-panel {
    height: 100%;
    border-radius: 1.25rem;
    background: hsl(187 100% 66%);
  }

  .hero__right {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1rem;
    padding: 1.5rem;
    background: hsl(332 100% 58%);
  }

  .hero__right-panel {
    border-radius: 1.25rem;
  }

  .hero__right-panel--top {
    background: hsl(12 100% 64%);
  }

  .hero__right-panel--bottom {
    background: hsl(48 100% 58%);
  }

  .hero__preview-item:nth-child(1) {
    background: hsl(42 100% 54%);
  }

  .hero__preview-item:nth-child(2) {
    background: hsl(159 100% 42%);
  }

  .hero__preview-item:nth-child(3) {
    background: hsl(271 100% 62%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__inner--animated {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 989px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .hero__inner:not(.hero__inner--preview) {
      grid-template-rows: 3fr 1fr;
    }

    .hero__left,
    .hero__right,
    .hero__preview-item {
      min-height: 0;
    }

    .hero__left,
    .hero__right {
      padding: 1rem;
    }

    .hero__left--split {
      grid-template-columns: 1fr 1fr;
    }

    .hero__inner--preview {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc(100% - 2.5rem);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      align-items: stretch;
    }

    .hero__inner--preview::-webkit-scrollbar {
      display: none;
    }

    .hero__preview-item {
      scroll-snap-align: center;
      scroll-snap-stop: always;
      min-height: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroSections = document.querySelectorAll('[data-hero-reveal]');

  heroSections.forEach((section) => {
    const rows = section.querySelectorAll('.hero__inner--animated');

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      rows.forEach((row) => row.classList.add('hero__inner--visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('hero__inner--visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: '0px 0px -10% 0px',
      }
    );

    rows.forEach((row) => observer.observe(row));
  });
{% endjavascript %}

{% schema %}
{
  "name": "Home hero",
  "settings": [],
  "presets": [
    {
      "name": "Home hero"
    }
  ]
}
{% endschema %}
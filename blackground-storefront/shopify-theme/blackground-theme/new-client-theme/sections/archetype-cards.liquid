<style>
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --black: #080808;
  --gold: #D4AF00;
  --white: #F2F0EB;
  --radius: 22px;
  --nav-h: 68px;
  --tab: 46px;
  --total: 8;
}

.stage {
  position: fixed;
  top: var(--nav-h);
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: clamp(500px, 96vw, 1500px);
  z-index: 10;
}

.card {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  border-radius: var(--radius);
  overflow: hidden;
  will-change: transform, opacity;
  transition: none;
}

.card {
  transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), opacity 0.4s ease;
}

.card-bg,
.card-over {
  position: absolute;
  inset: 0;
}

.card-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding: 0 clamp(28px, 4vw, 60px) clamp(80px, 9vh, 100px);
}

.card-num {
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.26em;
  color: var(--gold);
  opacity: 0.6;
  margin-bottom: 6px;
}

.card-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}

.card-hl {
  font-size: clamp(28px, 4vw, 62px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.04;
  margin-bottom: 10px;
}

.card-sub {
  font-size: clamp(12px, 1.3vw, 17px);
  font-weight: 400;
  opacity: 0.5;
}

.ghost {
  position: absolute;
  right: -6px;
  top: 50%;
  transform: translateY(-50%);
  font-size: clamp(80px, 13vw, 180px);
  font-weight: 700;
  letter-spacing: -0.04em;
  opacity: 0.04;
  user-select: none;
  white-space: nowrap;
  pointer-events: none;
  z-index: 1;
}

.find-btn {
  position: absolute;
  bottom: clamp(28px, 4vh, 44px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  background: transparent;
  border: 1.5px solid rgba(242, 240, 235, 0.3);
  border-radius: 999px;
  padding: 13px 30px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--white);
  cursor: pointer;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s, border-color 0.2s, color 0.2s, background 0.2s;
  backdrop-filter: blur(8px);
  text-decoration: none;
}

.card.is-active .find-btn {
  opacity: 1;
  pointer-events: all;
}

.find-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(212, 175, 0, 0.06);
}

.c1 .card-bg {
  background: #1a1200;
  background-image:
    repeating-linear-gradient(-45deg, transparent, transparent 28px, rgba(212, 175, 0, 0.07) 28px, rgba(212, 175, 0, 0.07) 29px),
    repeating-linear-gradient(45deg, transparent, transparent 28px, rgba(212, 175, 0, 0.04) 28px, rgba(212, 175, 0, 0.04) 29px);
}

.c1 .card-over {
  background: linear-gradient(to top, rgba(18, 10, 0, 0.96) 0%, rgba(18, 10, 0, 0.3) 55%, transparent 100%);
}

.c2 .card-bg {
  background: radial-gradient(ellipse 55% 65% at 68% 40%, #10130a 0%, #050d14 65%);
}

.c2 .card-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 28% 48% at 70% 38%, rgba(212, 175, 0, 0.1) 0%, transparent 70%);
}

.c2 .card-over {
  background: linear-gradient(to top, rgba(5, 13, 20, 0.97) 0%, rgba(5, 13, 20, 0.3) 55%, transparent 100%);
}

.c3 .card-bg {
  background: #060c08;
  background-image:
    linear-gradient(rgba(212, 175, 0, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(212, 175, 0, 0.055) 1px, transparent 1px);
  background-size: 64px 64px;
}

.c3 .card-bg::after {
  content: '';
  position: absolute;
  top: 28px;
  right: 40px;
  width: 120px;
  height: 120px;
  border-top: 1px solid rgba(212, 175, 0, 0.28);
  border-right: 1px solid rgba(212, 175, 0, 0.28);
}

.c3 .card-over {
  background: linear-gradient(to top, rgba(6, 12, 8, 0.97) 0%, rgba(6, 12, 8, 0.2) 60%, transparent 100%);
}

.c4 .card-bg {
  background: #150c00;
}

.c4 .card-bg::before {
  content: '';
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  border: 1px solid rgba(212, 175, 0, 0.1);
  top: -110px;
  right: 6%;
}

.c4 .card-bg::after {
  content: '';
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  border: 1px solid rgba(212, 175, 0, 0.2);
  top: 8%;
  right: 18%;
}

.c4 .card-over {
  background: linear-gradient(to top, rgba(15, 10, 0, 0.97) 0%, rgba(15, 10, 0, 0.3) 55%, transparent 100%);
}

.c5 .card-bg {
  background: #090909;
}

.c5 .card-bg::before {
  content: '';
  position: absolute;
  width: 200%;
  height: 1px;
  top: 40%;
  left: -50%;
  background: linear-gradient(to right, transparent, rgba(212, 175, 0, 0.16) 30%, rgba(212, 175, 0, 0.16) 70%, transparent);
  box-shadow: 0 16px 0 rgba(212, 175, 0, 0.07), 0 32px 0 rgba(212, 175, 0, 0.04), 0 -16px 0 rgba(212, 175, 0, 0.07);
}

.c5 .card-over {
  background: linear-gradient(to top, rgba(9, 9, 9, 0.98) 0%, rgba(9, 9, 9, 0.55) 50%, rgba(9, 9, 9, 0.2) 100%);
}

.c6 .card-bg {
  background: #0f0c05;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(212, 175, 0, 0.065) 39px, rgba(212, 175, 0, 0.065) 40px),
    repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(212, 175, 0, 0.065) 39px, rgba(212, 175, 0, 0.065) 40px),
    repeating-linear-gradient(45deg, transparent, transparent 19px, rgba(212, 175, 0, 0.03) 19px, rgba(212, 175, 0, 0.03) 20px),
    repeating-linear-gradient(-45deg, transparent, transparent 19px, rgba(212, 175, 0, 0.03) 19px, rgba(212, 175, 0, 0.03) 20px);
}

.c6 .card-over {
  background: linear-gradient(to top, rgba(10, 8, 3, 0.97) 0%, rgba(10, 8, 3, 0.3) 55%, transparent 100%);
}

.c7 .card-bg {
  background: #050c15;
  background-image:
    linear-gradient(90deg, rgba(212, 175, 0, 0.05) 1px, transparent 1px),
    linear-gradient(0deg, rgba(212, 175, 0, 0.025) 1px, transparent 1px);
  background-size: 32px 32px;
}

.c7 .card-bg::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  bottom: 0;
  width: 1px;
  background: linear-gradient(to bottom, transparent, rgba(212, 175, 0, 0.35) 25%, rgba(212, 175, 0, 0.35) 75%, transparent);
}

.c7 .card-over {
  background: linear-gradient(to top, rgba(5, 12, 21, 0.97) 0%, rgba(5, 12, 21, 0.3) 55%, transparent 100%);
}

.c8 .card-bg {
  background: #0b050e;
  background-image:
    linear-gradient(rgba(212, 175, 0, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(212, 175, 0, 0.055) 1px, transparent 1px);
  background-size: 80px 80px;
}

.c8 .card-bg::after {
  content: '';
  position: absolute;
  top: 40%;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(to right, transparent 0%, rgba(212, 175, 0, 0.4) 18%, rgba(212, 175, 0, 0.4) 44%, transparent 56%, rgba(212, 175, 0, 0.4) 68%, rgba(212, 175, 0, 0.4) 88%, transparent 100%);
}

.c8 .card-over {
  background: linear-gradient(to top, rgba(11, 5, 14, 0.97) 0%, rgba(11, 5, 14, 0.3) 55%, transparent 100%);
}

.dots {
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 300;
  display: flex;
  gap: 7px;
  align-items: center;
}

.dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(242, 240, 235, 0.22);
  cursor: pointer;
  transition: background 0.35s, transform 0.35s;
}

.dot.on {
  transform: scale(1.55);
}

@media screen and (max-width: 749px) {
  .stage {
    width: 100vw;
  }

  .card {
    border-radius: 0;
  }

  .card-body {
    padding: 0 24px 96px;
  }

  .card-hl {
    font-size: clamp(34px, 11vw, 52px);
  }

  .card-sub {
    font-size: 14px;
  }

  .ghost {
    right: -20px;
    font-size: clamp(76px, 24vw, 130px);
  }

  .find-btn {
    bottom: 42px;
    padding: 12px 22px;
    font-size: 9px;
  }

  .dots {
    bottom: 80px;
  }
}
</style>


{{ 'blackground-result.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blackground-quiz.js' | asset_url }}" defer></script>
<script src="{{ 'blackground-result.js' | asset_url }}" defer></script>

<section
  class="bg-result-page full-width"
  data-blackground-result
  data-quiz-url="{{ section.settings.quiz_page_url | default: '/pages/blackground-quiz' }}"
>
  <div class="bg-result-page__inner">
    <div class="bg-result-page__header">
      <p class="bg-result-page__eyebrow bg-mono">Your Blackground</p>
      <h1 class="bg-result-page__title bg-serif">Archetype Result</h1>
      <p class="bg-result-page__subtitle bg-mono">Your result is calculated in the browser for this first phase and stored temporarily on this device.</p>
    </div>

    <div class="bg-result-page__app" data-blackground-result-app></div>

    <noscript>
      <p class="bg-result-page__noscript bg-mono">This result page requires JavaScript to read your saved quiz result.</p>
    </noscript>
  </div>
</section>

{% schema %}
{
  "name": "Blackground result",
  "settings": [
    {
      "type": "url",
      "id": "quiz_page_url",
      "label": "Quiz page URL"
    }
  ]
}
{% endschema %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.images.size
  assign has_media_stack = false
  assign archetype = product.metafields.custom.archetype.value
  assign care_instructions = product.metafields.custom.care_instructions
  assign fit_details = product.metafields.custom.fit
  assign default_detail_key = ''

  if media_count > 1
    assign has_media_stack = true
  endif

  if product.description != blank
    assign default_detail_key = 'description'
  elsif fit_details != blank
    assign default_detail_key = 'fit'
  elsif care_instructions != blank
    assign default_detail_key = 'care'
  endif

  assign style_label = 'STYLE'
  assign size_label = 'SIZE'

  for option in product.options_with_values
    assign normalized_name = option.name | strip | downcase

    if normalized_name == 'color' or normalized_name == 'colour'
      assign style_label = option.name | upcase
    endif

    if normalized_name == 'size'
      assign size_label = option.name | upcase
    endif
  endfor
%}

<section
  class="bg-product full-width"
  data-product-root
  data-section-id="{{ section.id }}"
  data-product='{{ product | json | escape }}'
>
  <div class="bg-product__inner">
    <div class="bg-product__layout">
      <div class="bg-product__media-column">
        <div
          class="bg-product__media-shell{% if has_media_stack %} bg-product__media-shell--stacked{% endif %}"
          data-product-media-stack
        >
          <div class="bg-product__media-frame">
            {% if product.images.size > 0 %}
              {% for image in product.images %}
                {% liquid
                  assign initial_depth = media_count | minus: forloop.index0
                  assign layer_state = 'hidden'
                  assign mid_depth = media_count | minus: 1
                  assign back_depth = media_count | minus: 2

                  if initial_depth == media_count
                    assign layer_state = 'front'
                  elsif initial_depth == mid_depth
                    assign layer_state = 'mid'
                  elsif initial_depth == back_depth
                    assign layer_state = 'back'
                  endif
                %}

                <div
                  class="bg-product__media-card{% if forloop.first %} is-active{% endif %}"
                  data-product-card
                  data-image-id="{{ image.id }}"
                  data-depth="{{ initial_depth }}"
                  data-layer-state="{{ layer_state }}"
                  style="--card-depth: {{ initial_depth }};"
                >
                  <img
                    class="bg-product__media-image"
                    src="{{ image | image_url: width: 1400 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                </div>
              {% endfor %}
            {% else %}
              <div
                class="bg-product__media-card bg-product__media-card--placeholder is-active"
                data-product-card
                data-depth="1"
                data-layer-state="front"
              >
                <div class="bg-product__media-placeholder" aria-hidden="true"></div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="bg-product__info-column bg-mono">
        {% form 'product', product, class: 'bg-product__form', data-product-form: '' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          <div class="bg-product__info-grid">
            <div class="bg-product__info-left">
              <div class="bg-product__header-block">
                <h1 class="bg-product__title">{{ product.title }}</h1>
                <p class="bg-product__price" data-product-price>{{ current_variant.price | money }}</p>
              </div>

              <div class="bg-product__meta-groups">
                {% for option in product.options_with_values %}
                  {% liquid
                    assign normalized_name = option.name | strip | downcase
                    assign display_label = option.name | upcase

                    if normalized_name == 'color' or normalized_name == 'colour'
                      assign display_label = 'STYLE'
                    elsif normalized_name == 'size'
                      assign display_label = 'SIZE'
                    endif
                  %}

                  <fieldset
                    class="bg-product__option-group"
                    data-option-group
                    data-option-position="{{ option.position }}"
                    data-option-name="{{ option.name | escape }}"
                  >
                    <legend class="bg-product__option-label">{{ display_label }}</legend>

                    <div class="bg-product__option-values">
                      <select
                        id="bg-product-option-{{ section.id }}-{{ option.position }}"
                        class="bg-product__option-select"
                        data-option-select
                        data-option-position="{{ option.position }}"
                        data-option-name="{{ option.name | escape }}"
                      >
                        {% if normalized_name == 'size' %}
                          <option value="" selected>SELECT</option>
                        {% endif %}

                        {% for value in option.values %}
                          <option
                            value="{{ value | escape }}"
                            {% if normalized_name != 'size' and option.selected_value == value %}selected{% endif %}
                          >
                            {{ value | upcase }}
                          </option>
                        {% endfor %}
                      </select>
                    </div>
                  </fieldset>
                {% endfor %}
              </div>

              {% if archetype != blank %}
                <div class="bg-product__archetype">
                  <p class="bg-product__archetype-label">ARCHETYPE:</p>
                  <p class="bg-product__archetype-value">{{ archetype }}</p>
                </div>
              {% endif %}

              {% if product.description != blank or care_instructions != blank or fit_details != blank %}
                <div class="bg-product__details" data-product-details>
                  {% if product.description != blank %}
                    <div class="bg-product__detail-item" data-product-detail-item>
                      <input
                        id="product-detail-description-{{ section.id }}"
                        class="bg-product__detail-radio"
                        type="radio"
                        name="product-detail-{{ section.id }}"
                        value="description"
                        data-product-detail-trigger
                        {% if default_detail_key == 'description' %}checked{% endif %}
                      >

                      <label class="bg-product__detail-trigger" for="product-detail-description-{{ section.id }}">
                        <span>DESCRIPTION</span>
                        <span class="bg-product__detail-icon" aria-hidden="true">+</span>
                      </label>
                    </div>
                  {% endif %}

                  {% if fit_details != blank %}
                    <div class="bg-product__detail-item" data-product-detail-item>
                      <input
                        id="product-detail-fit-{{ section.id }}"
                        class="bg-product__detail-radio"
                        type="radio"
                        name="product-detail-{{ section.id }}"
                        value="fit"
                        data-product-detail-trigger
                        {% if default_detail_key == 'fit' %}checked{% endif %}
                      >

                      <label class="bg-product__detail-trigger" for="product-detail-fit-{{ section.id }}">
                        <span>FIT</span>
                        <span class="bg-product__detail-icon" aria-hidden="true">+</span>
                      </label>
                    </div>
                  {% endif %}

                  {% if care_instructions != blank %}
                    <div class="bg-product__detail-item" data-product-detail-item>
                      <input
                        id="product-detail-care-{{ section.id }}"
                        class="bg-product__detail-radio"
                        type="radio"
                        name="product-detail-{{ section.id }}"
                        value="care"
                        data-product-detail-trigger
                        {% if default_detail_key == 'care' %}checked{% endif %}
                      >

                      <label class="bg-product__detail-trigger" for="product-detail-care-{{ section.id }}">
                        <span>CARE INSTRUCTIONS</span>
                        <span class="bg-product__detail-icon" aria-hidden="true">+</span>
                      </label>
                    </div>
                  {% endif %}
                </div>
              {% endif %}

              <div class="bg-product__actions">
                <button
                  class="bg-product__add-to-bag"
                  type="submit"
                  data-add-to-cart
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {% if current_variant.available %}
                    ADD TO BAG
                  {% else %}
                    SOLD OUT
                  {% endif %}
                </button>
              </div>
            </div>

            <div class="bg-product__info-right">
              <div class="bg-product__detail-display" data-product-detail-display>
                {% if product.description != blank %}
                  <div
                    id="bg-product-detail-description-{{ section.id }}"
                    class="bg-product__detail-source{% if default_detail_key == 'description' %} is-active{% endif %}"
                    data-product-detail-panel="description"
                  >
                    <div class="bg-product__detail-content rte">
                      {{ product.description }}
                    </div>
                  </div>
                {% endif %}

                {% if fit_details != blank %}
                  <div
                    id="bg-product-detail-fit-{{ section.id }}"
                    class="bg-product__detail-source{% if default_detail_key == 'fit' %} is-active{% endif %}"
                    data-product-detail-panel="fit"
                  >
                    <div class="bg-product__detail-content rte">
                      {{ fit_details | metafield_tag }}
                    </div>
                  </div>
                {% endif %}

                {% if care_instructions != blank %}
                  <div
                    id="bg-product-detail-care-{{ section.id }}"
                    class="bg-product__detail-source{% if default_detail_key == 'care' %} is-active{% endif %}"
                    data-product-detail-panel="care"
                  >
                    <div class="bg-product__detail-content rte">
                      {{ care_instructions | metafield_tag }}
                    </div>
                  </div>
                {% endif %}
              </div>

              <div class="bg-product__complete-look-shell" data-product-complete-look></div>
            </div>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .bg-product {
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(3rem, 7vw, 5.5rem);
    padding-inline: clamp(1rem, 3vw, 2.5rem);
    color: var(--gold);
    box-sizing: border-box;
    block-size: calc(100dvh - var(--header-height, 0px) - clamp(7.5rem, 12vh, 10rem));
    overflow: hidden;
  }

  .bg-product__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    block-size: 100%;
  }

  .bg-product__layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.92fr) minmax(22rem, 1.08fr);
    column-gap: 0;
    row-gap: clamp(1.4rem, 2.75vw, 2rem);
    align-items: stretch;
    block-size: 100%;
    min-height: 0;
  }

  .bg-product__media-column {
    min-width: 0;
    min-height: 0;
  }

  .bg-product__media-shell {
    position: sticky;
    top: calc(var(--header-height, 0px) + 1.5rem);
    width: min(100%, 34rem);
    block-size: 100%;
  }

  .bg-product__media-shell--stacked {
    cursor: pointer;
  }

  .bg-product__media-frame {
    position: relative;
    aspect-ratio: auto;
    block-size: 100%;
    min-height: 0;
    border-radius: clamp(2rem, 2.5vw, 2.8rem);
    overflow: hidden;
  }

  .bg-product__media-card {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    background: var(--media-gray);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 0, 0) scale(1.01);
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease;
    will-change: transform, opacity;
  }

  .bg-product__media-card--placeholder,
  .bg-product__media-placeholder {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--media-gray);
  }

  .bg-product__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bg-product__media-card.is-active {
    z-index: 2;
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    pointer-events: auto;
  }

  .bg-product__media-card.is-previous {
    z-index: 1;
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .bg-product__info-column {
    min-width: 0;
    min-height: 0;
    padding-top: clamp(0.2rem, 0.6vw, 0.6rem);
    margin-inline-start: calc(clamp(2rem, 2.5vw, 2.8rem) * -1);
    position: relative;
    z-index: 3;
  }

  .bg-product__header-block {
    display: grid;
    gap: 0.35rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .bg-product__title,
  .bg-product__price,
  .bg-product__option-label,
  .bg-product__archetype-label,
  .bg-product__archetype-value,
  .bg-product__detail-trigger,
  .bg-product__add-to-bag,
  .bg-product__option-value {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bg-product__title,
  .bg-product__price,
  .bg-product__option-label,
  .bg-product__archetype-label,
  .bg-product__archetype-value,
  .bg-product__detail-trigger,
  .bg-product__add-to-bag,
  .bg-product__option-value {
    font-size: clamp(1rem, 1.05vw, 1.15rem);
    line-height: 1.15;
  }

  .bg-product__title,
  .bg-product__price {
    margin: 0;
  }

  .bg-product__form {
    display: block;
    block-size: 100%;
  }

  .bg-product__info-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 22rem) minmax(16rem, 1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: stretch;
    block-size: 100%;
    min-height: 0;
  }

  .bg-product__info-left {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    align-content: start;
    min-height: 0;
    overflow: hidden;
  }

  .bg-product__info-right {
    min-width: 0;
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
    min-height: 100%;
  }

  .bg-product__meta-groups {
    display: grid;
    gap: 1rem;
  }

  .bg-product__option-group {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.45rem;
  }

  .bg-product__option-label {
    margin: 0;
  }

  .bg-product__option-values {
    position: relative;
    display: inline-flex;
    width: min(100%, 20rem);
  }

  .bg-product__option-select {
    width: 100%;
    min-width: 0;
    padding: 0 1rem 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--gold);
    font: inherit;
    font-size: clamp(1rem, 1.05vw, 1.15rem);
    letter-spacing: 0.08em;
    line-height: 1.15;
    text-transform: uppercase;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .bg-product__option-select option {
    background: var(--bg);
    color: var(--gold);
  }

  .bg-product__option-values::after {
    content: '\2304';
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 50%;
    transform: translateY(-52%);
    font-size: 0.8em;
    line-height: 1;
    pointer-events: none;
  }

  .bg-product__archetype {
    display: grid;
    gap: 0.45rem;
    max-width: 30ch;
  }

  .bg-product__archetype-label,
  .bg-product__archetype-value {
    margin: 0;
  }

  .bg-product__detail-display,
  .bg-product__complete-look-shell {
    min-height: 0;
  }

  .bg-product__detail-display {
    display: grid;
    align-content: start;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .bg-product__detail-display::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none;
  }

  .bg-product__details {
    display: grid;
    gap: 0;
    max-width: min(100%, 20rem);
    border-block: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
  }

  .bg-product__detail-item + .bg-product__detail-item {
    border-top: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
  }

  .bg-product__detail-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .bg-product__detail-trigger {
    width: 100%;
    padding: 0.95rem 0;
    border: 0;
    background: transparent;
    color: var(--gold);
    font: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    cursor: pointer;
  }

  .bg-product__detail-radio:checked + .bg-product__detail-trigger {
    color: var(--white-soft);
  }

  .bg-product__detail-trigger:hover,
  .bg-product__detail-trigger:focus-visible {
    color: var(--white-soft);
  }

  .bg-product__detail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1rem;
    transition: transform 180ms ease;
  }

  .bg-product__detail-radio:checked + .bg-product__detail-trigger .bg-product__detail-icon {
    transform: rotate(45deg);
  }

  .bg-product__detail-source {
    display: none;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  .bg-product__detail-source.is-active {
    display: block;
  }

  .bg-product__detail-content {
    width: 100%;
    max-width: none;
    font-size: clamp(0.96rem, 0.98vw, 1.06rem);
    line-height: 1.45;
    text-transform: none;
  }

  .bg-product__detail-content > :first-child,
  .bg-product__detail-content .metafield-rich_text_field > :first-child {
    margin-top: 0;
  }

  .bg-product__detail-content > :last-child,
  .bg-product__detail-content .metafield-rich_text_field > :last-child {
    margin-bottom: 0;
  }

  .bg-product__complete-look-shell {
    min-height: 0;
  }

  .bg-product__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bg-product__add-to-bag {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--gold);
    font: inherit;
    cursor: pointer;
  }

  .bg-product__add-to-bag:hover,
  .bg-product__add-to-bag:focus-visible {
    color: var(--white-soft);
  }

  .bg-product__add-to-bag:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media screen and (max-width: 1099px) {
    .bg-product__layout {
      grid-template-columns: 1fr;
      block-size: auto;
    }

    .bg-product__media-shell {
      position: relative;
      top: auto;
      width: min(100%, 30rem);
      block-size: auto;
    }

    .bg-product__info-column {
      padding-top: 0;
      margin-inline-start: 0;
    }

    .bg-product__info-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      block-size: auto;
    }

    .bg-product__info-right {
      grid-template-rows: auto;
      min-height: auto;
    }

    .bg-product__detail-display {
      overflow-y: visible;
    }
  }

  @media screen and (max-width: 749px) {
    .bg-product {
      padding-block-start: 1.25rem;
      block-size: auto;
      overflow: visible;
    }

    .bg-product__media-shell {
      width: 100%;
    }

    .bg-product__media-frame {
      block-size: auto;
      min-height: auto;
      aspect-ratio: 0.77;
    }

    .bg-product__detail-content,
    .bg-product__details {
      max-width: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');

    if (!section) {
      return;
    }

    const productData = JSON.parse(section.dataset.product || '{}');
    const variantInput = section.querySelector('[data-variant-id]');
    const priceNode = section.querySelector('[data-product-price]');
    const addToCartButton = section.querySelector('[data-add-to-cart]');
    const optionSelects = Array.from(section.querySelectorAll('[data-option-select]'));
    const optionGroups = Array.from(section.querySelectorAll('[data-option-group]'));
    const detailTriggers = Array.from(section.querySelectorAll('[data-product-detail-trigger]'));
    const detailPanels = Array.from(section.querySelectorAll('[data-product-detail-panel]'));
    const mediaStack = section.querySelector('[data-product-media-stack]');
    const mediaCards = Array.from(section.querySelectorAll('[data-product-card]'));

    const formatter = new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency: '{{ cart.currency.iso_code }}'
    });

    const variants = Array.isArray(productData.variants) ? productData.variants : [];
    const selectedOptions = {};

    optionGroups.forEach((group) => {
      const position = Number(group.dataset.optionPosition);
      const selectedSelect = group.querySelector('[data-option-select]');

      if (selectedSelect) {
        selectedOptions[position] = selectedSelect.value;
      }
    });

    const findMatchingVariant = () => {
      return variants.find((variant) => {
        return Object.keys(selectedOptions).every((key) => {
          const optionIndex = Number(key) - 1;
          return variant.options?.[optionIndex] === selectedOptions[key];
        });
      });
    };

    const getVariantImageId = (variant) => {
      if (!variant) {
        return null;
      }

      return variant.featured_image?.id || variant.featured_media?.id || null;
    };

    let activeMediaIndex = 0;
    let isMediaTransitionLocked = false;

    const applyActiveMedia = (targetIndex) => {
      if (!mediaCards.length) {
        return;
      }

      const normalizedIndex = ((targetIndex % mediaCards.length) + mediaCards.length) % mediaCards.length;
      const previousIndex = activeMediaIndex;

      mediaCards.forEach((card, index) => {
        card.classList.toggle('is-active', index === normalizedIndex);
        card.classList.toggle('is-previous', index === previousIndex && previousIndex !== normalizedIndex);
      });

      activeMediaIndex = normalizedIndex;
    };

    const setActiveMediaByImageId = (imageId) => {
      if (!mediaCards.length) {
        return;
      }

      if (!imageId) {
        applyActiveMedia(0);
        return;
      }

      const matchIndex = mediaCards.findIndex((card) => {
        return String(card.dataset.imageId) === String(imageId);
      });

      applyActiveMedia(matchIndex >= 0 ? matchIndex : 0);
    };

    const applyVariant = (variant) => {
      if (!variantInput || !priceNode || !addToCartButton) {
        return;
      }

      if (!variant) {
        variantInput.value = '';
        addToCartButton.disabled = true;
        addToCartButton.textContent = 'UNAVAILABLE';
        return;
      }

      variantInput.value = variant.id;
      priceNode.textContent = formatter.format((variant.price || 0) / 100);
      addToCartButton.disabled = !variant.available;
      addToCartButton.textContent = variant.available ? 'ADD TO BAG' : 'SOLD OUT';

      setActiveMediaByImageId(getVariantImageId(variant));
    };

    optionSelects.forEach((select) => {
      select.addEventListener('change', () => {
        const position = Number(select.dataset.optionPosition);
        selectedOptions[position] = select.value;

        applyVariant(findMatchingVariant());
      });
    });

    const setActiveDetailPanel = (detailKey) => {
      detailPanels.forEach((panel) => {
        const isActivePanel = panel.dataset.productDetailPanel === detailKey;
        panel.classList.toggle('is-active', isActivePanel);
      });
    };

    detailTriggers.forEach((trigger) => {
      trigger.addEventListener('change', () => {
        if (!trigger.checked) {
          return;
        }

        setActiveDetailPanel(trigger.value);
      });
    });

    const activeTrigger = detailTriggers.find((trigger) => trigger.checked);

    if (activeTrigger) {
      setActiveDetailPanel(activeTrigger.value);
    }

    if (mediaStack && mediaCards.length > 1) {
      mediaStack.addEventListener('click', () => {
        if (isMediaTransitionLocked) {
          return;
        }

        isMediaTransitionLocked = true;

        applyActiveMedia(activeMediaIndex + 1);

        window.setTimeout(() => {
          mediaCards.forEach((card) => {
            card.classList.remove('is-previous');
          });

          isMediaTransitionLocked = false;
        }, 320);
      });
    }

    const initialVariant =
      findMatchingVariant() ||
      variants.find((variant) => String(variant.id) === String(variantInput?.value));

    applyVariant(initialVariant);
  })();
</script>


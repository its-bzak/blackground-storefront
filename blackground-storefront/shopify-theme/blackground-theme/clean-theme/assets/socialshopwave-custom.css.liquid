#ssw-avg-rate-profile-html {
  margin-bottom: 10px;
}

.ssw-add-review-wrapper .add_recommend {
  color: #fff;
}

.ssw-fave-btn-default:hover .ssw-fave-btn-content,
.ssw-fave-btn-default:hover .ssw-fave-btn-counter,
.ssw-fave-btn-default:hover .ssw-fave-btn-counter:before {  
  border-color:#b0b0b0;
}
.ssw-fave-btn-default .ssw-fave-btn-content {
  transition:none;
}

#widget-fave-html {
  width: 100%;
  margin-top: 10px;
}

#widget-fave-html .ssw-fave-btn {
  width: 100%; 
  line-height: 50px;
}

#widget-fave-html .ssw-fave-btn-content {
  width: 100%;
  font-family: var(--typeBasePrimary), var(--typeBaseFallback);
  font-size: 20px;
  border-radius: 0;
  color: #000;
  border-color: var(--colorBtnPrimary);
  background-color: var(--colorBtnPrimary);
  letter-spacing: var(--typeBaseSpacing);
  font-weight: var(--typeBaseWeight);
}

#widget-fave-html .ssw-fave-btn-counter,
#widget-fave-html .ssw-fave-btn-counter:before {
  border-radius: 0;
  color: #000;
  border-color: var(--colorBtnPrimary);
  background-color: var(--colorBtnPrimary);
}

#ssw-fave-page-side-bar .ssw-h3 .ssw-fave-page-left-header__name {
  color: #fff;
}

.gw-container .gw-link-wishlist, .ssw-fave-result-board {
  color: #fff;
}

.ssw-fave-btn-content, .ssw-cmar, .ssw-review-counter, .ssw-modal-body, .ssw-reward-box-title{
  color: #000;
}

.ssw-add-review.gw-btn-border.gw-review-btn.gw-fsize-md {
  padding: 0;
}

.ssw-modal-content .ssw-modal-body {
  color: black;
}

.ssw-reward-page-earning-rule, .ssw-reward-page-spending-rule {
  color: #eee331;
}

.ssw-reviews-widget .ssw-text {
  color: black;
}

textarea.ssw-input-block-level {
  color: black;
}

#ssw-fave-page-side-bar .ssw-fave-list-title {
  border: 1px solid white;
  color: white;
}

textarea.ssw-input-block-level{
  color: #fff!important;
}